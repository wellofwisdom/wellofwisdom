{
  "productName": "Well of Wisdom",
  "version": "0.0.1",
  "identifier": "app.wellofwisdom.desktop",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Well of Wisdom",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../docs/examples/comparing-fractions.wow-course.json": "data/courses/comparing-fractions.wow-course.json",
      "../docs/examples/fractions-through-sewing.wow-course.json": "data/courses/fractions-through-sewing.wow-course.json",
      "../docs/examples/photosynthesis-through-cooking.wow-course.json": "data/courses/photosynthesis-through-cooking.wow-course.json",
      "../docs/examples/horoscope-vs-science.wow-course.json": "data/courses/horoscope-vs-science.wow-course.json",
      "../docs/examples/river-ecology-field-study.wow-course.json": "data/courses/river-ecology-field-study.wow-course.json",
      "../server/templates/adventures": "data/adventures",
      "../server/templates/plans": "data/plans"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "iconPath": "icons/icon.ico"
    },
    "macOS": {
      "icon": "icons/icon.png"
    }
  }
}
