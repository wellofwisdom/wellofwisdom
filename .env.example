# Well of Wisdom — example environment
# Copy to .env and adjust. Nothing here is required to boot the app;
# the app runs degraded-but-healthy without a database or AI endpoint.

PORT=3000

# Postgres (the docker-compose.yml sets this for you)
DATABASE_URL=postgres://wow:wow@localhost:5432/wellofwisdom

# AI — any OpenAI-compatible endpoint. Leave AI_BASE_URL empty to run without AI.
#   Ollama (local, free):   http://localhost:11434/v1
#   LM Studio (local):      http://localhost:1234/v1
#   DeepSeek:               https://api.deepseek.com/v1
#   OpenAI:                 https://api.openai.com/v1
#   Any other OpenAI-compatible provider works too.
AI_BASE_URL=
AI_API_KEY=
# Model names depend on your provider. Ollama examples: llama3.1, qwen2.5:14b
AI_MODEL_PRO=gpt-4o-mini
AI_MODEL_FLASH=gpt-4o-mini
