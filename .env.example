# Well of Wisdom: example environment
# Copy to .env and adjust. Nothing here is required to boot the app;
# the app runs degraded-but-healthy without a database or AI endpoint.

PORT=3000

# --- database ---
# DB_DRIVER=pg (default) uses Postgres via DATABASE_URL.
# DB_DRIVER=pglite uses an embedded database with no Postgres. The directory in
# DATA_DIR holds the database files; it must be persistent or every restart
# wipes the data. The Docker image defaults to /app/data.
#DB_DRIVER=pg
#DATABASE_URL=postgres://wow:wow@localhost:5432/wellofwisdom
# PGlite embedded mode: DB_DRIVER=pglite, DATA_DIR is where the files live.
# Example: DB_DRIVER=pglite and DATA_DIR=/app/data
# When DB_DRIVER=pglite, DATABASE_URL is ignored.
#DATA_DIR=
DATABASE_URL=postgres://wow:wow@localhost:5432/wellofwisdom

# AI. Any OpenAI-compatible endpoint, Claude (Anthropic), or Gemini (Google).
# Leave empty to run without AI. Examples:
#   Ollama (local, free):   http://localhost:11434/v1
#   LM Studio (local):      http://localhost:1234/v1
#   DeepSeek:               https://api.deepseek.com/v1
#   OpenAI:                 https://api.openai.com/v1
#   Claude (Anthropic):     https://api.anthropic.com          (set AI_PROVIDER=anthropic)
#   Gemini (Google):        https://generativelanguage.googleapis.com  (set AI_PROVIDER=gemini)
AI_BASE_URL=
AI_API_KEY=
# AI_PROVIDER: auto-detected from AI_BASE_URL (api.anthropic.com -> claude,
#   generativelanguage.googleapis.com -> gemini), or set explicitly:
#   AI_PROVIDER=openai      (DeepSeek, OpenAI, Ollama, LM Studio, any OpenAI-compatible)
#   AI_PROVIDER=anthropic   (Claude. Needs an Anthropic key: sk-ant-...)
#   AI_PROVIDER=gemini      (Gemini. Needs a Google AI key from aistudio.google.com)
#AI_PROVIDER=
# Model names depend on your provider.
#   OpenAI/DeepSeek:  gpt-4o-mini, deepseek-chat
#   Claude:           claude-sonnet-4-5, claude-haiku-4-5, claude-opus-4-5
#   Gemini:           gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
#   Ollama:           llama3.1, qwen2.5:14b, llava (vision)
AI_MODEL_PRO=gpt-4o-mini
AI_MODEL_FLASH=gpt-4o-mini

# Google sign in for guides (optional but recommended for cloud).
# Get a Client ID at https://console.cloud.google.com/apis/credentials -> Create Credentials -> OAuth client ID (Web).
# Add https://wellofwisdom.app and http://localhost:3000 to Authorized JavaScript origins.
# When set, the logged-out page shows "Continue with Google" and One Tap; /api/auth/google verifies via Google's tokeninfo.
# Leave empty on a private self-host with no Google need.
#GOOGLE_CLIENT_ID=1234567890-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Invite gate: when set, family signup requires this code. Lets you enable AI
# on a public instance safely: only families you invite can join.
SIGNUP_INVITE_CODE=

# --- uploaded media ---
# Where uploaded video/images are written. MUST be a persistent volume, or
# every deploy loses them. The Docker image defaults to /app/data/uploads.
UPLOAD_DIR=
UPLOAD_MAX_VIDEO_MB=500
UPLOAD_MAX_IMAGE_MB=20
UPLOAD_MAX_AUDIO_MB=100
# Storage driver: local (default, UPLOAD_DIR) or s3 (any S3-compatible endpoint
# via the AWS SDK v3 S3 client: AWS S3, Cloudflare R2, MinIO, etc.).
#STORAGE_DRIVER=local
# S3-compatible storage. Leave empty when STORAGE_DRIVER is local.
#S3_ENDPOINT=https://s3.amazonaws.com
#S3_BUCKET=wellofwisdom-uploads
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
#S3_REGION=us-east-1

# --- public demo mode: top of the cloud funnel ---
# Turn on the one-click demo at /api/demo/login and the Try the demo buttons
# on the logged-out page. A visitor gets a throwaway family with learners and
# courses in seconds, no invite or email, so they can feel the product before
# they pay. The family is RETAINED, not wiped: keep it and upgrade it to a real
# cloud account rather than resetting nightly. Self-hosters leave this off.
#DEMO_MODE=true
# Keep demo visitors on one shared family. Cheaper on launch day; turn off
# once you charge for cloud and want each buyer to keep their own data.
#DEMO_SINGLE_FAMILY=true

# Photo to worksheet: phone photo -> graded exercises. Uses the SAME AI
# provider as everything else, but as a vision model. When set, the Import
# worksheet dialog gains a Choose photo button that reads the page to text,
# which the guide corrects before it becomes exercises.
#   OpenAI/DeepSeek:  gpt-4o-mini (or gpt-4o, etc.)
#   Claude:           claude-sonnet-4-5 (or any Claude vision model)
#   Gemini:           gemini-2.0-flash, gemini-1.5-flash
#   Ollama (local):   llava, llava:13b, qwen2-vl, etc.
# Needs AI_API_KEY (and AI_BASE_URL for OpenAI-compat). Leave empty to keep
# paste-only import.
#AI_VISION_MODEL=gpt-4o-mini

# --- immersive audio: voice + music (makes the world a game, not a reader) ---
# Same billing you already have: kie.ai. Voice is Gemini 3.1 Flash TTS (Google,
# text to speech) on kie; music is Suno Generate Music on kie. One key, same
# spend path, loops cached in UPLOAD_DIR like kie images. No GCP project
# needed, no separate Vertex setup. Leave both models empty and the world
# stays silent, which is fine for schools on strict no-sound. Browser
# speechSynthesis remains as fallback when voice is off.
# Voice on kie: Gemini 3.1 Flash TTS. kie prices (your discount):
#   input  $0.70 per million tokens, output $14 per million tokens.
#   A chapter narration is a few thousand tokens, so voice stays sub cent.
#GOOGLE_TTS_ON_KIE=gemini-3.1-flash-tts
#GOOGLE_TTS_VOICE_NARRATOR=en-US-Chirp3-HD-Achernar
#GOOGLE_TTS_VOICE_CHARACTER=en-US-Chirp3-HD-Schedar
# Music on kie: Suno Generate Music at $0.06 per generation. One loop per
# chapter, cached, cheap. See Suno model list for extras (lyrics, stems,
# etc), but base generation is what ships first.
#SUNO_MUSIC_ON_KIE=suno-generate-music

# --- speech input: a learner talks instead of typing (answer boxes, tutor) ---
# Any OpenAI-compatible /v1/audio/transcriptions endpoint. Groq and OpenAI
# serve Whisper cheaply, and a self-hosted faster-whisper container speaks the
# same protocol, so a recording never has to leave your own network. Leave
# STT_BASE_URL empty and the microphone falls back to the browser's own
# recogniser where it exists (Chrome, Edge), which sends the audio to the
# browser vendor instead. With neither, the microphone is hidden.
#   Groq:      https://api.groq.com/openai/v1        model whisper-large-v3-turbo
#   OpenAI:    https://api.openai.com/v1             model whisper-1
#   DeepInfra: https://api.deepinfra.com/v1/openai   model openai/whisper-large-v3
#   Local:     http://whisper:9000/v1                model whisper-1
# The person who runs the server can set all of this in Settings > AI vault
# instead. The vault wins when both are set, and the same "speech input" card
# holds the daily call cap and the keep-recordings switch. That card follows
# INSTANCE_ADMIN_EMAILS below, because the endpoint is shared by every family.
#STT_BASE_URL=
# Leave empty when STT_BASE_URL is the same host as AI_BASE_URL: the main AI
# key is reused there, and a key for one provider is never sent to another
# provider's host.
#STT_API_KEY=
# media.js reads this name too, for kie auto-captions (its own default is
# elevenlabs/speech-to-text). So on a box that uses both, set the transcription
# model in the vault and leave this blank.
#STT_MODEL=whisper-large-v3-turbo
# Transcriptions a family may make per day. 0 or empty means the money caps
# alone decide. Speech is cheap per call and easy to trigger by accident.
#STT_DAILY_CAP=200
# Keep the recordings themselves. Off means the audio exists only for the one
# request that transcribed it and is never written to disk. A family can
# override this for itself in its own preferences.
#STT_KEEP_RECORDINGS=false
# Size limit for one recording. A short spoken answer is a few hundred KB.
#STT_MAX_UPLOAD_MB=8

# --- fetching links people paste ---
# Course sources, import-by-URL and PeerTube lookups fetch addresses a guide
# typed. Private, loopback and link-local addresses are always refused. Add the
# server's OWN public address here (and anything else it must never fetch):
# from inside, a request to it can reach the host and skip an edge firewall.
# Comma list of addresses or CIDR ranges, e.g. 203.0.113.7/32,2001:db8::/32
FETCH_BLOCK_CIDRS=
# --- proxies and browser policy ---
# How many reverse proxies sit in front of the app. Decides which X-Forwarded-For
# entry is the client for the login and demo rate limits. 1 (default) for one
# proxy such as Traefik, nginx, Caddy or Coolify; 2 with Cloudflare in front of
# that proxy; false when the app is exposed directly. Never true on a public
# instance: it lets a client pick its own address.
#TRUST_PROXY=1
# Content-Security-Policy on every response: enforce (default), report (same
# policy as Report-Only, watch the browser console), or off.
#CSP_MODE=enforce
# Extra sources for img, media, frame and connect, space separated, for a
# self-hosted video host or media CDN that is not plain https.
#CSP_EXTRA_SOURCES=
# Body limit for course import, worksheet paste and photo OCR (the rest is 2mb).
#IMPORT_BODY_LIMIT=25mb
# Behind Cloudflare, read the client address from this header instead of
# X-Forwarded-For (Traefik rewrites that to the Cloudflare edge). Only safe
# when the box is reachable through Cloudflare alone. Leave empty otherwise.
#CLIENT_IP_HEADER=cf-connecting-ip

# --- who runs this server ---
# Owners allowed to change settings shared by every family: the AI vault, the
# email provider, media keys, and the waitlist. Comma separated emails. When
# empty, the owners of the first non-demo family on the server have it (the
# person who installed a self-host). A hosted instance with a public demo
# should always set this.
#INSTANCE_ADMIN_EMAILS=you@example.org
