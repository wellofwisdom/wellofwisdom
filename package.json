{
  "name": "wellofwisdom",
  "version": "0.0.1",
  "description": "Open-source, AI-first learning platform for families, classrooms, schools, co-ops and tutors. Courses shaped around what each learner loves, played as a world. Self-host in one command.",
  "license": "AGPL-3.0-or-later",
  "type": "commonjs",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:web": "npm --prefix web run dev",
    "build": "npm --prefix web run build",
    "test": "node --test",
    "test:pglite": "node scripts/test-pglite.js",
    "check": "node scripts/check.js",
    "validate-course": "node scripts/validate-course.js",
    "build:sea": "node scripts/build-sea.js",
    "verify:install": "node scripts/verify-install.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1131.0",
    "archiver": "^8.0.0",
    "express": "^4.19.2",
    "pg": "^8.12.0"
  },
  "optionalDependencies": {
    "@electric-sql/pglite": "^0.2.17"
  },
  "devDependencies": {
    "postject": "^1.0.0-alpha.6"
  }
}
